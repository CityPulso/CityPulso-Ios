    "bundle_method_offline_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay at the front desk. Your bundle starts when the venue confirms they received it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payez à l’accueil. Votre forfait démarre quand la salle confirme le paiement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到前台付款。球馆确认收款后时长包生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到前台付款。球館確認收款後時長包生效。"
          }
        }
      }
    },
