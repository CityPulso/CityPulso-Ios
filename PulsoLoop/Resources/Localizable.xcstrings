    "app_icon_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon packs don’t follow the theme or the system light/dark mode. After switching packs, reopen the app to see the new icon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les packs d’icônes ne suivent ni le thème ni le mode clair/sombre du système. Après un changement de pack, rouvrez l’application pour voir la nouvelle icône."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标包不受主题和系统深浅色影响。换了图标包后，需要重新打开应用才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示包不受主題和系統深淺色影響。換了圖示包後，需要重新打開應用才會生效。"
