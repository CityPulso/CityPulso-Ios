        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帖子和它的评论会从所有论坛移除，无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帖子和它的留言會從所有論壇移除，無法復原。"
          }
        }
