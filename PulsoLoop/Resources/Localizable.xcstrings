    "event_join_registration_pay_card_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your spot is held for 10 minutes while you pay. If you don’t finish, the spot is released."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre place est retenue 10 minutes pendant le paiement. Sans paiement, elle est libérée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款期间为你保留名额 10 分钟，未完成付款名额会被释放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款期間為你保留名額 10 分鐘，未完成付款名額會被釋放。"
          }
        }
      }
    },
    "event_join_registration_pay_card_queue_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You join the waitlist now. When a spot opens for you, it’s held for 10 minutes so you can pay by card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous rejoignez la liste d’attente. Quand une place se libère pour vous, elle est retenue 10 minutes pour payer par carte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在加入候补。有名额轮到你时，会为你保留 10 分钟，方便你用银行卡付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你現在加入候補。有名額輪到你時，會為你保留 10 分鐘，方便你用銀行卡付款。"
          }
        }
      }
    },
