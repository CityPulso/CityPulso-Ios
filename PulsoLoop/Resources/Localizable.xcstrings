    },
    "venue_membership_method_offline_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay at the front desk. Your membership starts when the venue confirms they received it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payez à l’accueil. L’adhésion commence quand la salle confirme avoir reçu le paiement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到前台付款。球馆确认收到款项后，会员才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到前台付款。球館確認收到款項後，會員才會生效。"
          }
        }
      }
    },
    "venue_membership_method_phone_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call the venue to settle payment. Your membership starts when the venue confirms they received it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appelez la salle pour régler. L’adhésion commence quand la salle confirme avoir reçu le paiement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "致电球馆约定付款。球馆确认收到款项后，会员才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "致電球館約定付款。球館確認收到款項後，會員才會生效。"
          }
        }
      }
    },
    "venue_membership_method_platform_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay by card now. Your membership starts when the payment succeeds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payez par carte maintenant. L’adhésion commence après le paiement."
