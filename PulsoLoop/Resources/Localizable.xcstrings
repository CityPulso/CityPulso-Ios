      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked to leave but still holds the spot, so it counts as joined until someone on the waitlist takes over"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A demandé à partir mais garde sa place : elle reste comptée comme inscrite jusqu’à ce qu’un joueur en attente la reprenne"
          }
        },
        "zh-Hans": {
