    "venue_book_rules": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-minute slots, %2$@–%3$@ minutes per court, bookable up to %4$@ days ahead. Times are the venue’s local time. One booking covers at most 48 hours in total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créneaux de %1$@ minutes, %2$@ à %3$@ minutes par terrain, réservables jusqu’à %4$@ jours à l’avance. Heures locales de la salle. Une réservation couvre 48 heures au total au maximum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 分钟一格，每块场地 %2$@–%3$@ 分钟，可提前 %4$@ 天订场。时间都按球馆当地时间，一次订场合计最多 48 小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 分鐘一格，每塊場地 %2$@–%3$@ 分鐘，可提前 %4$@ 天訂場。時間都按球館當地時間，一次訂場合計最多 48 小時。"
          }
        }
      }
    },
