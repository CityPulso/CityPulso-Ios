    "event_join_registration_no_platform_fee": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card payments go straight to the host’s Stripe account. CityPulso adds no fee and keeps nothing; Stripe’s processing fee is the only cost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements par carte vont directement sur le compte Stripe de l’organisateur. CityPulso n’ajoute aucun frais et ne garde rien ; seuls les frais de traitement Stripe s’appliquent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行卡付款直接进入发起人的 Stripe 账户。CityPulso 不加任何费用、不经手这笔钱，唯一的成本是 Stripe 手续费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行卡付款直接進入發起人的 Stripe 賬户。CityPulso 不加任何費用、不經手這筆錢，唯一的成本是 Stripe 手續費。"
          }
        }
      }
    },
    "event_join_registration_pay_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your spot is held. Pay below to confirm it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre place est retenue. Payez ci-dessous pour la confirmer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名额已为你保留，请在下方付款以确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名額已為你保留，請在下方付款以確認。"
          }
        }
      }
    },
    "event_join_registration_pay_card": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
