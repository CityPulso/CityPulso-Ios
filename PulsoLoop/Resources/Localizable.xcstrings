    "storage_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data is kept only on this phone. After you clear it, chats, notifications and lists load again when you open them. Chat backgrounds and drafts can’t be recovered. You stay signed in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces données sont gardées uniquement sur ce téléphone. Une fois effacées, les discussions, notifications et listes se rechargent quand vous les ouvrez. Les fonds de discussion et les brouillons ne peuvent pas être récupérés. Vous restez connecté."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些数据只存在这台手机上。清除后，聊天、通知和列表会在你打开时重新加载；聊天背景和草稿清除后无法找回。清除不会退出登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些資料只存在這台手機上。清除後，聊天、通知和列表會在你打開時重新載入；聊天背景和草稿清除後無法找回。清除不會登出。"
          }
        }
      }
    },
