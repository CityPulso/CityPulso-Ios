    "place_mark_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us which sports venue, outdoor court or park is missing from the map. Once a moderator approves it, everyone can find it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-nous quelle salle, quel terrain extérieur ou quel parc manque sur la carte. Une fois approuvé, tout le monde pourra le trouver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉我们地图上缺了哪个球馆、户外场地或公园。审核通过后它会出现在地图上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴我們地圖上缺了哪個球館、户外場地或公園。審核通過後它會出現在地圖上。"
          }
        }
      }
