    "venue_board_error_too_long": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each court can be booked for up to %1$@ minutes. Remove some time slots"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque terrain peut être réservé %1$@ minutes au maximum. Retirez quelques créneaux"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每块场地最多订 %1$@ 分钟，请减少所选时段"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每塊場地最多訂 %1$@ 分鐘，請減少所選時段"
          }
        }
      }
    },
    "venue_board_error_too_short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each court needs at least %1$@ minutes. Add more time slots"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque terrain doit être réservé au moins %1$@ minutes. Ajoutez des créneaux"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每块场地至少订 %1$@ 分钟，请再选几个时段"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每塊場地至少訂 %1$@ 分鐘，請再選幾個時段"
          }
        }
      }
    },
    "venue_board_error_total_too_long": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A booking can cover up to %1$@ hours in total. Remove some time slots."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réservation ne peut pas dépasser %1$@ heures au total. Retirez quelques créneaux."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次订场合计最多 %1$@ 小时，请减少所选时段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次訂場合計最多 %1$@ 小時，請減少所選時段。"
          }
        }
      }
    },
    "venue_board_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a slot to select or clear it. Long-press, then drag to select several in a row. You can book several courts at once, up to 48 hours in total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un créneau pour le sélectionner ou le retirer. Appuyez longuement puis glissez pour en sélectionner plusieurs. Plusieurs terrains possibles, 48 heures au total maximum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点格子选择或取消这个时段；长按后拖动可以连续选择。可以同时订多块场地，一次合计最多 48 小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點格子選擇或取消這個時段；長按後拖動可以連續選擇。可以同時訂多塊場地，一次合計最多 48 小時。"
          }
        }
      }
    },
