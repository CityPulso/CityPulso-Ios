    "event_detail_my_status_pending_exit_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The spot is still yours. You’re out once someone on the waitlist takes it; until then, plan to show up"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La place reste à vous. Vous êtes libéré dès qu’un joueur en attente la reprend ; d’ici là, prévoyez de venir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名额还在你名下。有候补球友顶替后你才算离开；没人顶替的话，你仍要到场"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名額還在你名下。有候補球友頂替後你才算離開；沒人頂替的話，你仍要到場"
          }
        }
      }
    },
