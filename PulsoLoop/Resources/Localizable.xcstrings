    "event_detail_join_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You take a spot on the roster. If you leave later, someone on the waitlist may need to take your spot first, or your exit stays pending."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous prenez une place. Si vous partez plus tard, quelqu’un de la liste d’attente devra peut-être vous remplacer, ou votre sortie restera en attente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入后你占一个名额。之后想退出，可能要等候补球友顶上，或者先进入待退出状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入後你佔一個名額。之後想退出，可能要等候補球友頂上，或者先進入待退出狀態。"
          }
        }
      }
    },
