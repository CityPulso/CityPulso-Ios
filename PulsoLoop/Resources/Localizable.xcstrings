    "venue_refund_summary_online_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refunds apply to online payments. Call-to-confirm and pay-at-venue bookings settle with the venue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les remboursements concernent les paiements en ligne. Les réservations par téléphone ou payées sur place se règlent avec la salle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款只适用于在线付款；电话确认和到店付款的订场由球馆处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退款只適用於線上付款；電話確認和到店付款的訂場由球館處理。"
          }
        }
      }
    },
    "venue_refund_summary_tier": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least %1$@ h before start: %2$@%% back"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins %1$@ h avant le début : %2$@ %% remboursé"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开场前至少 %1$@ 小时：退 %2$@%%"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開場前至少 %1$@ 小時：退 %2$@%%"
          }
        }
      }
    },
    "venue_refund_summary_tier_later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later than that: no refund"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tard : aucun remboursement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更晚取消：不退款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更晚取消：不退款"
          }
        }
      }
    },
    "venue_refund_summary_types_full_refund_minus_provider_fee": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel any time before start and get your payment back, minus Stripe’s card processing fee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez à tout moment avant le début et récupérez votre paiement, moins les frais de carte de Stripe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开场前随时取消，退还付款（扣除 Stripe 刷卡手续费）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開場前隨時取消，退還付款（扣除 Stripe 刷卡手續費）。"
          }
        }
      }
    },
    "venue_refund_summary_types_non_refundable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online payments are not refunded if you cancel. You can still cancel to free the courts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements en ligne ne sont pas remboursés en cas d’annulation. Vous pouvez quand même annuler pour libérer les terrains."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消后在线付款不退款，但你仍可以取消以释放场地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消後線上付款不退款，但你仍可以取消以釋放場地。"
          }
        }
      }
    },
    "venue_refund_summary_types_tiered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much comes back depends on how early you cancel:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant remboursé dépend de l’avance avec laquelle vous annulez :"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款多少取决于你提前多久取消："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退款多少取決於你提前多久取消："
          }
        }
      }
    },
    "venue_refund_summary_venue_cancels": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the venue cancels, agree any refund with the venue directly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la salle annule, convenez du remboursement directement avec elle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是球馆取消，退款请直接和球馆协商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是球館取消，退款請直接和球館協商。"
          }
        }
      }
    },
    "venue_refund_types_full_refund_minus_provider_fee_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel any time; the booker gets everything back except Stripe’s processing fee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulation à tout moment ; tout est remboursé sauf les frais de carte Stripe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时取消，退还除 Stripe 手续费外的全部金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時取消，退還除 Stripe 手續費外的全部金額。"
          }
        }
      }
    },
