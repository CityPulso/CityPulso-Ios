    "profile_identities_apply_coach_approved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are a coach. Open the Coach menu to partner with venues."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes coach. Ouvrez le menu Coach pour vous associer à des salles sportifs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已是教练，可在「教练」菜单中与球馆合作。"
