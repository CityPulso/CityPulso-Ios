    "discussion_create_forum_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give your players one place to talk, plan games and post notices. Each profile can run up to 30 forums."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offrez à vos joueurs un lieu pour discuter, organiser des parties et publier des avis. Chaque profil peut gérer jusqu’à 30 forums."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给球友一个固定的地方聊天、约球、发通知。每个身份最多创建 30 个论坛。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給球友一個固定的地方聊天、約球、發通知。每個身份最多建立 30 個論壇。"
          }
        }
      }
    },
