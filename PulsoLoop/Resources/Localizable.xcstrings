    "app_icon_relaunch_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The home-screen icon has changed, and the app needs a fresh start to use it. It closes when you confirm. Open it again from the home screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icône de l’écran d’accueil a changé et l’application doit redémarrer pour l’utiliser. Elle se fermera quand vous confirmerez. Rouvrez-la depuis l’écran d’accueil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面图标已经换了，应用需要重新打开才能用上。点「确认」后应用会关闭，请从桌面再打开一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "桌面圖示已經換了，應用需要重新打開才能用上。點「確認」後應用會關閉，請從桌面再打開一次。"
          }
        }
      }
    },
