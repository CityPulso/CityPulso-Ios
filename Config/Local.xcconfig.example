// 复制为 Config/Local.xcconfig（已在 .gitignore），按本机改。
//
// Debug 的 API 地址，必填无默认（对应 Android local.properties 的 api.base.url）：
// 模拟器用 localhost；真机用开发机局域网 IP。dev Traefik 的 HTTP 端口是 10101，在 /api 上 strip 前缀。
PULSO_API_BASE_URL = http:/$()/192.168.1.76:10101/api

// 真机调试的签名团队（Xcode → Settings → Accounts 里的 Team ID）。
DEVELOPMENT_TEAM =
