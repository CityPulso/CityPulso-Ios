            "value": "YouNeary"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouNeary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "娱邻"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "娛鄰"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to take photos in chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour prendre des photos dans le chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于聊天拍照发送图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於聊天拍照發送圖片。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for nearby activities and to show where you are on the map"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sert aux activités à proximité et à vous situer sur la carte"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于附近活动、地图定位和你的当前位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於附近活動、地圖定位和你的當前位置"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to send voice messages in chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour envoyer des messages vocaux dans le chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于聊天发送语音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於聊天發送語音。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to pick photos from the gallery in chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour choisir des photos dans la galerie du chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于聊天从相册选择图片发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於聊天從相冊選擇圖片發送。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
