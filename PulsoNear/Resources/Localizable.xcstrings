    "venue_refund_summary_online_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refunds apply to online payments. Call-to-confirm and pay-at-venue bookings settle with the venue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les remboursements concernent les paiements en ligne. Les réservations par téléphone ou payées sur place se règlent avec l’établissement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款只适用于在线付款；电话确认和到店付款的预约由门店处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退款只適用於線上付款；電話確認和到店付款的預約由門店處理。"
          }
        }
      }
    },
    "venue_refund_summary_tier": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least %1$@ h before start: %2$@%% back"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins %1$@ h avant le début : %2$@ %% remboursé"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开场前至少 %1$@ 小时：退 %2$@%%"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開場前至少 %1$@ 小時：退 %2$@%%"
          }
        }
      }
    },
    "venue_refund_summary_tier_later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later than that: no refund"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tard : aucun remboursement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更晚取消：不退款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更晚取消：不退款"
          }
        }
      }
    },
    "venue_refund_summary_types_full_refund_minus_provider_fee": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel any time before start and get your payment back, minus Stripe’s card processing fee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez à tout moment avant le début et récupérez votre paiement, moins les frais de carte de Stripe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开场前随时取消，退还付款（扣除 Stripe 刷卡手续费）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開場前隨時取消，退還付款（扣除 Stripe 刷卡手續費）。"
          }
        }
      }
    },
    "venue_refund_summary_types_non_refundable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online payments are not refunded if you cancel. You can still cancel to free the tables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements en ligne ne sont pas remboursés en cas d’annulation. Vous pouvez quand même annuler pour libérer les tables."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消后在线付款不退款，但你仍可以取消以释放桌台。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消後線上付款不退款，但你仍可以取消以釋放桌台。"
          }
        }
      }
    },
    "venue_refund_summary_types_tiered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much comes back depends on how early you cancel:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant remboursé dépend de l’avance avec laquelle vous annulez :"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款多少取决于你提前多久取消："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退款多少取決於你提前多久取消："
          }
        }
      }
    },
    "venue_refund_summary_venue_cancels": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the venue cancels, agree any refund with the venue directly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’établissement annule, convenez du remboursement directement avec lui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是门店取消，退款请直接和门店协商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是門店取消，退款請直接和門店協商。"
          }
        }
      }
    },
    "venue_refund_types_full_refund_minus_provider_fee_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel any time; the booker gets everything back except Stripe’s processing fee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulation à tout moment ; tout est remboursé sauf les frais de carte Stripe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时取消，退还除 Stripe 手续费外的全部金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時取消，退還除 Stripe 手續費外的全部金額。"
          }
        }
      }
    },
    "venue_refund_types_full_refund_minus_provider_fee_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full refund minus card fee"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remboursement moins les frais"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全额退款（扣除手续费）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全額退款（扣除手續費）"
          }
        }
      }
    },
    "venue_refund_types_non_refundable_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookers can still cancel, but online payments are not refunded."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’annulation reste possible, mais les paiements en ligne ne sont pas remboursés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约人仍可取消，但在线付款不退。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預約人仍可取消，但線上付款不退。"
          }
        }
      }
    },
    "venue_refund_types_non_refundable_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Non-refundable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non remboursable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
