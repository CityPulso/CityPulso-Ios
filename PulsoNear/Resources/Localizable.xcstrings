    "payment_accounts_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each payment account is your own Stripe account. It belongs to your login and is shared by all your profiles. Player payments land there directly. CityPulso takes no cut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque compte de paiement est votre propre compte Stripe. Il appartient à votre identifiant et est partagé par tous vos profils. Les paiements des joueurs y arrivent directement. CityPulso ne prend aucune commission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个收款账户都是你自己的 Stripe 账户，归属你的登录账号，所有身份共用。玩家的付款直接进入该账户，CityPulso 不抽成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個收款賬户都是你自己的 Stripe 賬户，歸屬你的登入帳戶，所有身份共用。玩家的付款直接進入該賬户，CityPulso 不抽成。"
          }
        }
      }
    },
