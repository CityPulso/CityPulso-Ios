          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電話確認"
          }
        }
      }
    },
    "venue_payments_modes_platform_booker_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay by card within 10 minutes and your booking is confirmed instantly. Refunds follow the venue policy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payez par carte sous 10 minutes et c’est confirmé tout de suite. Remboursements selon la politique de l’établissement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 分钟内刷卡付款即可立即确认。退款遵循门店政策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "10 分鐘內刷卡付款即可立即確認。退款遵循門店政策。"
          }
        }
      }
    },
    "venue_payments_modes_platform_title": {
