    "discussion_archive_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No new posts or comments will be accepted. Existing content stays readable and you can reopen any time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus aucune publication ni commentaire ne sera accepté. Le contenu existant reste lisible et vous pouvez rouvrir à tout moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档后不再接受新帖子和评论，已有内容仍可查看。随时可以恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歸檔後不再接受新帖子和評論，已有內容仍可查看。隨時可以恢復。"
          }
        }
      }
    },
    "discussion_archive_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiving stops new posts and comments. Everything stays readable and you can reopen any time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’archivage bloque les nouvelles publications et commentaires. Tout reste lisible et vous pouvez rouvrir à tout moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档后不再接受新帖子和评论，已有内容仍可查看，随时可以恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歸檔後不再接受新帖子和評論，已有內容仍可查看，隨時可以恢復。"
          }
        }
      }
