    "activity_join_registration_no_platform_fee": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card payments go straight to the host’s Stripe account. CityPulso adds no fee and keeps nothing; Stripe’s processing fee is the only cost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paiements par carte vont directement sur le compte Stripe de l’organisateur. CityPulso n’ajoute aucun frais et ne garde rien ; seuls les frais de traitement Stripe s’appliquent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行卡付款直接进入发起人的 Stripe 账户。CityPulso 不加任何费用、不经手这笔钱，唯一的成本是 Stripe 手续费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行卡付款直接進入發起人的 Stripe 賬户。CityPulso 不加任何費用、不經手這筆錢，唯一的成本是 Stripe 手續費。"
          }
        }
      }
    },
    "activity_join_registration_pay_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your spot is held. Pay below to confirm it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre place est retenue. Payez ci-dessous pour la confirmer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名额已为你保留，请在下方付款以确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名額已為你保留，請在下方付款以確認。"
          }
        }
      }
    },
    "activity_join_registration_pay_card": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay by card now"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payer par carte maintenant"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在用银行卡付款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在用銀行卡付款"
          }
        }
      }
    },
    "activity_join_registration_pay_card_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your spot is held for 10 minutes while you pay. If you don’t finish, the spot is released."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre place est retenue 10 minutes pendant le paiement. Sans paiement, elle est libérée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款期间为你保留名额 10 分钟，未完成付款名额会被释放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款期間為你保留名額 10 分鐘，未完成付款名額會被釋放。"
          }
        }
      }
    },
    "activity_join_registration_pay_card_queue_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You join the waitlist now. When a spot opens for you, it’s held for 10 minutes so you can pay by card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
