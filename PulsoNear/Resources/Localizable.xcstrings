    "activity_detail_waitlist_dialog_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: leave the waitlist this many hours before the start. A waitlist spot isn’t a confirmed place, so you only come if a spot opens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : quitter la liste d’attente ce nombre d’heures avant le début. Une place en liste d’attente n’est pas confirmée : vous ne venez que si une place se libère."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选填：开始前多少小时自动退出候补。候补不等于报名成功，没有名额就不用到场。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選填：開始前多少小時自動退出候補。候補不等於報名成功，沒有名額就不用到場。"
          }
        }
      }
    },
