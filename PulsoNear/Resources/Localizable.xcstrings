    "place_empty_pending_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found a venue or park that’s missing from the map? Mark it so others can find it. Up to %1$lld places can wait at once."
          }
        },
