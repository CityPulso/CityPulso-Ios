    "venue_payments_modes_offline_booker_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your request waits for the venue to confirm. Pay at the front desk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre demande attend la confirmation de l’établissement. Paiement à l’accueil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约申请等门店确认，到前台付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預約申請等門店確認，到前台付款。"
