          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不可退款"
          }
        }
      }
    },
    "venue_refund_types_tiered_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The earlier they cancel, the more they get back. You set the tiers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus l’annulation est tôt, plus le remboursement est élevé. Vous fixez les paliers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消越早退得越多，阶梯由你设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消越早退得越多，階梯由你設定。"
          }
        }
      }
    },
    "venue_refund_types_tiered_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiered by notice"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selon le préavis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按提前时间阶梯退款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按提前時間階梯退款"
          }
        }
      }
