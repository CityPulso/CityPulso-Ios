    "discussion_delete_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The forum, its announcements and its publication records are removed. The posts themselves are kept. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le forum, ses annonces et ses enregistrements de publication sont supprimés. Les publications elles-mêmes sont conservées. Cette action est irréversible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "论坛、公告和它在帖子上的发布记录都会删除，帖子本身保留。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "論壇、公告和它在帖子上的發佈記錄都會刪除，帖子本身保留。此操作無法撤銷。"
          }
        }
      }
    },
    "discussion_delete_post_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The post and its comments disappear from every forum. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La publication et ses commentaires disparaissent de tous les forums. Cette action est irréversible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帖子和它的评论会从所有论坛移除，无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帖子和它的評論會從所有論壇移除，無法撤銷。"
          }
        }
      }
    },
