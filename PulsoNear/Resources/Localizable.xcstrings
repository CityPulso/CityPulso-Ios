    "discussion_create_forum_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give your group one place to talk, plan meetups and post notices. Each profile can run up to 30 forums."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offrez à votre groupe un lieu pour discuter, organiser des sorties et publier des avis. Chaque profil peut gérer jusqu’à 30 forums."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给大家一个固定的地方聊天、约局、发通知。每个身份最多创建 30 个论坛。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給大家一個固定的地方聊天、約局、發通知。每個身份最多建立 30 個論壇。"
          }
        }
      }
    },
    "discussion_create_section_activity_type_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Members find forums by activity type; leave it empty for every activity"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres cherchent les forums par type d’activité ; laissez vide pour toutes les activités"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员按活动类型找论坛；不选就对所有活动开放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "成員按活動類型找論壇；不選就對所有活動開放"
          }
        }
      }
    },
