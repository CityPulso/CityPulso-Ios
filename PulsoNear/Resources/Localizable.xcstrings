    "venue_payments_modes_phone_booker_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We hold your tables for 15 minutes. Call the venue to confirm; you pay at the venue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tables sont retenues 15 minutes. Appelez l’établissement pour confirmer ; paiement sur place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们为你保留桌台 15 分钟，请致电门店确认，到场付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們為你保留桌台 15 分鐘，請致電門店確認，到場付款。"
          }
        }
      }
    },
    "venue_payments_modes_phone_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call to confirm"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appeler pour confirmer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
