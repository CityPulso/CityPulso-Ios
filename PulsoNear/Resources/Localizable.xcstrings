        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现地图上没有的门店或公园？标记它，审核通过后大家都能找到。最多可以同时有 %1$lld 个地点在等待审核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發現地圖上沒有的門店或公園？標記它，審核通過後大家都能找到。最多可以同時有 %1$lld 個地點在等待審核。"
          }
