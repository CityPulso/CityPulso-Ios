    "activity_detail_exit_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You leave the roster. If free exit is closed, someone on the waitlist may need to take your spot first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous quittez la liste. Si la sortie libre est fermée, quelqu’un de la liste d’attente devra peut-être prendre votre place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将离开名单。如果没开放自由退出，可能要等候补玩家顶上才能离开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你將離開名單。如果沒開放自由退出，可能要等候補玩家頂上才能離開。"
          }
        }
      }
