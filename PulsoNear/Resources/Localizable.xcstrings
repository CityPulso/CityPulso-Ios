    "venue_board_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a slot to select or clear it. Long-press, then drag to select several in a row. You can book several tables at once, up to 48 hours in total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un créneau pour le sélectionner ou le retirer. Appuyez longuement puis glissez pour en sélectionner plusieurs. Plusieurs tables possibles, 48 heures au total maximum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点格子选择或取消这个时段；长按后拖动可以连续选择。可以同时订多块桌台，一次合计最多 48 小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點格子選擇或取消這個時段；長按後拖動可以連續選擇。可以同時訂多塊桌台，一次合計最多 48 小時。"
          }
        }
      }
    },
