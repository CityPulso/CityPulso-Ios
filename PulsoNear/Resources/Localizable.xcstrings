    "payments_hold_direct": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You pay %1$@ directly through Stripe. CityPulso adds no fee and keeps nothing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous payez %1$@ directement via Stripe. CityPulso n’ajoute aucun frais et ne garde rien."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你通过 Stripe 直接付款给%1$@，CityPulso 不收取任何费用，也不经手这笔钱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你通過 Stripe 直接付款給%1$@，CityPulso 不收取任何費用，也不經手這筆錢。"
