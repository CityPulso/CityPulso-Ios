    "venue_book_rules": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-minute slots, %2$@–%3$@ minutes per table, bookable up to %4$@ days ahead. Times are the venue’s local time. One booking covers at most 48 hours in total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créneaux de %1$@ minutes, %2$@ à %3$@ minutes par table, réservables jusqu’à %4$@ jours à l’avance. Heures locales de l’établissement. Une réservation couvre 48 heures au total au maximum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 分钟一格，每块桌台 %2$@–%3$@ 分钟，可提前 %4$@ 天预约。时间都按门店当地时间，一次预约合计最多 48 小时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 分鐘一格，每塊桌台 %2$@–%3$@ 分鐘，可提前 %4$@ 天預約。時間都按門店當地時間，一次預約合計最多 48 小時。"
          }
        }
      }
